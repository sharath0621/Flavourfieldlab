# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER exposed to the client. Used for
# storage uploads and AI-pipeline writes in server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider ---
# "mock" (default if unset) runs the deterministic rule-based classifier
# ported from the prototype — zero cost, no key required, good for local dev.
# "openai" calls a real model with structured JSON output.
AI_PROVIDER=mock
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
